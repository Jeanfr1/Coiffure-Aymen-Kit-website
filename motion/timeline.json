{
  "model":3,
  "name":"Le Fauteuil Signature",
  "video":false,
  "technique":"Plans HTML/SVG/CSS — composition 2,5D",
  "opening":{
    "start_when":["fonts ready","chair decoded","scrollY < 24","motion allowed"],
    "signature":{"duration_ms":1050,"delay_ms":100,"mask":"inset(0 100% 0 0) vers inset(0)"},
    "chair":{"duration_ms":1100,"delay_ms":50,"translate_y_from_px":16,"scale_from":1.025,"opacity_from":0.45},
    "title":{"duration_ms":800,"delay_ms":180,"translate_y_from_px":18},
    "cleanup_ms":1350,"blocks_navigation":false
  },
  "scroll":{
    "desktop_runway_svh":152,"mobile_runway_svh":144,
    "progress":"clamp(-heroRect.top/(heroHeight-stageHeight),0,1)",
    "copy_opacity":"1-smoothstep(0.18,0.57,p)","copy_y_px":[0,-25],
    "chair_x":"-p * min(viewportWidth * 0.045,74)","chair_y_px":[0,-12],
    "chair_scale":[1,1.025],"chair_opacity":"1-smoothstep(0.3,0.92,p)",
    "signature_x":"p * viewportWidth * 0.035","signature_opacity":"1-smoothstep(0.18,0.72,p)",
    "pointer_x_max_px":4,
    "comb_reveal":{"strips":5,"width":0.202,"x_step":0.2,"height_formula":"smoothstep(0.34+i*0.055,0.78+i*0.055,p)"},
    "hidden_controls_become_inert":true
  },
  "section_parallax":{"ratio_limit":0.8,"desktop_multiplier_px":18,"mobile_multiplier_px":10},
  "text_reveal":{"translate_y_px":15,"duration_ms":700,"threshold":0.12,"once":true},
  "reduced_motion":{"sticky":false,"extra_runway":false,"intro":false,"parallax":false,"all_content_visible":true},
  "manual_pause":true,"save_data_respected":true,"preference_key":"aymen.motion.paused",
  "rendering":"requestAnimationFrame demandé par événements, pas de boucle permanente",
  "not_delivered":"Rotation réelle de fauteuil en 3D, modèle GLB, vidéo ou séquence de frames"
}
